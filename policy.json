{
  "rules": [
    {"id": "rm-protected-path", "action": "block", "why": "recursive delete of a root, home, parent or .git path",
     "cmd": ["rm"], "flags": [["-r", "-R", "--recursive"]],
     "pos_re": "^(/|/\\*|~|~/|~/\\*|\\$HOME/?|\\$\\{HOME\\}/?|\\.|\\./|\\.\\.|\\.\\./|\\*|\\./\\*|/(bin|boot|etc|home|lib|opt|root|srv|usr|var)(/\\*?)?|(.*/)?\\.git/?)$"},
    {"id": "rm-recursive", "action": "warn", "why": "recursive delete",
     "cmd": ["rm"], "flags": [["-r", "-R", "--recursive"]]},
    {"id": "git-force-push-protected", "action": "block", "why": "force push to a protected branch",
     "cmd": ["git"], "sub": [["push"]], "flags": [["-f", "--force", "--force-with-lease"]],
     "pos_re": "(^|:)(main|master|production|prod|release)$"},
    {"id": "git-force-refspec-protected", "action": "block", "why": "force push (+refspec) to a protected branch",
     "cmd": ["git"], "sub": [["push"]], "pos_re": "^\\+(.*:)?(main|master|production|prod|release)$"},
    {"id": "git-force-push", "action": "warn", "why": "force push rewrites remote history",
     "cmd": ["git"], "sub": [["push"]], "flags": [["-f", "--force", "--force-with-lease"]]},
    {"id": "git-force-refspec", "action": "warn", "why": "force push (+refspec) rewrites remote history",
     "cmd": ["git"], "sub": [["push"]], "pos_re": "^\\+"},
    {"id": "git-reset-hard", "action": "warn", "why": "discards uncommitted work",
     "cmd": ["git"], "sub": [["reset"]], "flags": [["--hard"]]},
    {"id": "git-clean", "action": "warn", "why": "deletes untracked files",
     "cmd": ["git"], "sub": [["clean"]], "flags": [["-f", "--force"]], "not_flags": ["-n", "--dry-run"]},
    {"id": "git-branch-force-delete", "action": "warn", "why": "deletes a branch that may be unmerged",
     "cmd": ["git"], "sub": [["branch"]], "flags": [["-D"]]},
    {"id": "sql-destructive", "action": "block", "why": "destructive SQL statement",
     "cmd": ["psql", "mysql", "mariadb", "sqlite3", "duckdb", "clickhouse-client"],
     "args_re": "(?i)\\b(drop\\s+(table|database|schema)|truncate(\\s+table)?\\s+\\w|delete\\s+from\\s+\\w+\\s*;?\\s*$)"},
    {"id": "sql-destructive-piped", "action": "block", "why": "destructive SQL piped into a database client",
     "cmd": ["echo", "printf"], "downstream": ["psql", "mysql", "mariadb", "sqlite3", "duckdb", "clickhouse-client"],
     "args_re": "(?i)\\b(drop\\s+(table|database|schema)|truncate(\\s+table)?\\s+\\w|delete\\s+from\\s+\\w+\\s*;?\\s*$)"},
    {"id": "db-reset-script", "action": "warn", "why": "database reset task",
     "cmd": ["npm", "yarn", "pnpm", "bun", "npx", "prisma", "rake", "rails", "bundle", "php"],
     "args_re": "(?i)(\\bdb:(reset|drop)\\b|\\bmigrate:(reset|fresh)\\b|\\bmigrate\\s+reset\\b|--force-reset\\b)"},
    {"id": "pipe-to-shell", "action": "block", "why": "downloaded or decoded content piped into an interpreter",
     "cmd": ["curl", "wget", "base64", "nc", "ncat"],
     "downstream": ["sh", "bash", "zsh", "dash", "ksh", "python", "python3", "node", "perl", "ruby"]},
    {"id": "k8s-delete-namespace", "action": "block", "why": "deletes a whole Kubernetes namespace",
     "cmd": ["kubectl"], "sub": [["delete", "namespace"], ["delete", "namespaces"], ["delete", "ns"]]},
    {"id": "k8s-delete", "action": "warn", "why": "deletes Kubernetes resources",
     "cmd": ["kubectl"], "sub": [["delete"]]},
    {"id": "iac-destroy", "action": "block", "why": "destroys managed infrastructure",
     "cmd": ["terraform", "tofu", "pulumi"], "sub": [["destroy"]]},
    {"id": "iac-apply-destroy", "action": "block", "why": "destroys managed infrastructure",
     "cmd": ["terraform", "tofu"], "sub": [["apply"]], "flags": [["-destroy", "--destroy"]]},
    {"id": "chmod-world-writable", "action": "warn", "why": "recursive world-writable permissions",
     "cmd": ["chmod"], "flags": [["-R", "--recursive"]], "pos_re": "^(0?777|a\\+rwx|o\\+w)$"},
    {"id": "read-credential-file", "action": "block", "why": "reads a private key or credential file",
     "cmd": ["cat", "less", "more", "head", "tail", "bat", "cp", "scp", "base64", "xxd", "strings", "grep", "rg", "awk", "sed"],
     "pos_re": "(^|/)(id_(rsa|ed25519|ecdsa|dsa)|\\.aws/credentials|\\.netrc|\\.pgpass|\\.kube/config|[^/]*\\.pem)$"},
    {"id": "read-dotenv", "action": "warn", "why": "reads an env file that usually holds secrets",
     "cmd": ["cat", "less", "more", "head", "tail", "bat", "cp", "scp", "base64", "xxd", "strings", "grep", "rg", "awk", "sed"],
     "pos_re": "(^|/)\\.env(\\.(?!example|sample|template)[\\w.]+)?$"},
    {"id": "raw-disk-dd", "action": "block", "why": "writes directly to a block device",
     "cmd": ["dd"], "args_re": "\\bof=/dev/(sd|nvme|hd|vd|disk|mmcblk)"},
    {"id": "raw-disk-redirect", "action": "block", "why": "redirects output onto a block device",
     "redir_re": "^/dev/(sd|nvme|hd|vd|disk|mmcblk)"},
    {"id": "format-disk", "action": "block", "why": "formats or wipes a filesystem",
     "cmd_re": "^(mkfs(\\..+)?|wipefs)$"},
    {"id": "find-delete", "action": "warn", "why": "find with -delete",
     "cmd": ["find"], "flags": [["-delete"]]},
    {"id": "s3-recursive-delete", "action": "warn", "why": "recursive or forced S3 delete",
     "cmd": ["aws"], "sub": [["s3", "rm"], ["s3", "rb"]], "flags": [["--recursive", "--force"]]},
    {"id": "container-prune", "action": "warn", "why": "removes containers, images or volumes in bulk",
     "cmd": ["docker", "podman"], "sub": [["system", "prune"], ["volume", "prune"], ["volume", "rm"]]}
  ]
}
