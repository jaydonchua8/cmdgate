{
  "_comment": "risk is low|medium|high|critical. oacb names the equivalent rule in Unbound's open OACB baseline, where one exists.",
  "rules": [
    {"id": "rm-protected-path", "risk": "critical", "oacb": "OACB-RM-001", "why": "recursive delete of a root, home, system, parent or .git path", "cmd": ["rm"], "flags": [["-r", "-R", "--recursive"]], "pos_re": "^(/\\*?|(~|\\$HOME|\\$\\{HOME\\})/?\\*?|\\.{1,2}/?|\\*|\\./\\*|(~|\\$HOME|\\$\\{HOME\\})/[^/]+/?\\*?|/(home|Users)(/[^/]+)?/?\\*?|/(bin|boot|etc|lib|lib64|opt|root|sbin|srv|sys|usr)(/.*)?|/var(/(?!tmp/|folders/).*)?|(.*/)?\\.git/?)$"},
    {"id": "rm-variable-root", "risk": "high", "why": "recursive delete of $VAR/ which is / when the variable is empty", "cmd": ["rm"], "flags": [["-r", "-R", "--recursive"]], "pos_re": "^\\$\\{?[A-Za-z_]\\w*\\}?/\\*?$"},
    {"id": "rm-from-pipe", "risk": "high", "why": "recursive delete of targets read from a pipe", "cmd": ["rm"], "flags": [["-r", "-R", "--recursive"]], "via_any": ["xargs"]},
    {"id": "rm-recursive", "risk": "medium", "why": "recursive delete", "cmd": ["rm"], "flags": [["-r", "-R", "--recursive"]]},
    {"id": "find-delete-root", "risk": "critical", "oacb": "OACB-RM-003", "why": "find -delete starting at root or home", "cmd": ["find"], "first_pos_re": "^(/|(~|\\$HOME|\\$\\{HOME\\}))/?$", "flags": [["-delete"]]},
    {"id": "find-exec-rm-root", "risk": "critical", "oacb": "OACB-RM-004", "why": "find -exec rm starting at root or home", "cmd": ["find"], "first_pos_re": "^(/|(~|\\$HOME|\\$\\{HOME\\}))/?$", "args_re": "-(exec|execdir|ok|okdir)\\s+(\\S*/)?(rm|shred|unlink)\\b"},
    {"id": "find-delete", "risk": "medium", "why": "find with -delete", "cmd": ["find"], "flags": [["-delete"]]},
    {"id": "git-force-push-protected", "risk": "critical", "oacb": "OACB-GIT-001", "why": "force push to a protected branch", "cmd": ["git"], "sub": [["push"]], "flags": [["-f", "--force", "--force-with-lease"]], "pos_re": "(^|:)(main|master|production|prod|release(/.*)?)$"},
    {"id": "git-force-refspec-protected", "risk": "critical", "oacb": "OACB-GIT-001", "why": "force push (+refspec) to a protected branch", "cmd": ["git"], "sub": [["push"]], "pos_re": "^\\+(.*:)?(main|master|production|prod|release(/.*)?)$"},
    {"id": "git-force-push", "risk": "medium", "why": "force push rewrites remote history", "cmd": ["git"], "sub": [["push"]], "flags": [["-f", "--force", "--force-with-lease"]]},
    {"id": "git-force-refspec", "risk": "medium", "why": "force push (+refspec) rewrites remote history", "cmd": ["git"], "sub": [["push"]], "pos_re": "^\\+"},
    {"id": "git-reset-hard", "risk": "high", "why": "discards uncommitted work", "cmd": ["git"], "sub": [["reset"]], "flags": [["--hard"]]},
    {"id": "git-clean", "risk": "high", "why": "deletes untracked files", "cmd": ["git"], "sub": [["clean"]], "flags": [["-f", "--force"]], "not_flags": ["-n", "--dry-run"]},
    {"id": "git-branch-force-delete", "risk": "medium", "why": "deletes a branch that may be unmerged", "cmd": ["git"], "sub": [["branch"]], "flags": [["-D"]]},
    {"id": "sql-destructive", "risk": "critical", "why": "destructive SQL statement", "cmd": ["psql", "mysql", "mariadb", "sqlite3", "duckdb", "clickhouse-client"], "args_re": "(?i)\\b(drop\\s+(table|database|schema)|truncate(\\s+table)?\\s+\\w|delete\\s+from\\s+\\w+\\s*;?\\s*$)"},
    {"id": "sql-destructive-piped", "risk": "critical", "why": "destructive SQL piped into a database client", "cmd": ["echo", "printf"], "downstream": ["psql", "mysql", "mariadb", "sqlite3", "duckdb", "clickhouse-client"], "args_re": "(?i)\\b(drop\\s+(table|database|schema)|truncate(\\s+table)?\\s+\\w|delete\\s+from\\s+\\w+\\s*;?\\s*$)"},
    {"id": "db-reset-script", "risk": "high", "why": "database reset task", "cmd": ["npm", "yarn", "pnpm", "bun", "npx", "prisma", "rake", "rails", "bundle", "php"], "args_re": "(?i)(\\bdb:(reset|drop)\\b|\\bmigrate:(reset|fresh)\\b|\\bmigrate\\s+reset\\b|--force-reset\\b)"},
    {"id": "prisma-migrate-reset", "risk": "critical", "oacb": "OACB-DB-002", "why": "prisma migrate reset drops every table", "cmd": ["prisma"], "sub": [["migrate", "reset"]]},
    {"id": "drizzle-push-force", "risk": "high", "oacb": "OACB-DB-001", "why": "drizzle-kit push --force applies schema changes without review", "cmd": ["drizzle-kit"], "sub": [["push"]], "flags": [["--force"]]},
    {"id": "alembic-downgrade", "risk": "high", "oacb": "OACB-DB-003", "why": "alembic downgrade can drop columns and tables", "cmd": ["alembic"], "sub": [["downgrade"]]},
    {"id": "pipe-to-shell", "risk": "critical", "oacb": "OACB-NET-001", "why": "downloaded content piped into an interpreter", "cmd": ["curl", "wget", "fetch", "nc", "ncat"], "downstream": ["sh", "bash", "zsh", "dash", "ksh", "fish", "python", "python3", "node", "perl", "ruby", "php"], "untrusted_url": ["sh.rustup.rs", "rustup.rs", "bun.sh", "astral.sh", "nodejs.org", "deb.nodesource.com", "get.docker.com", "cli.github.com", "starship.rs", "sh.uv.astral.sh"]},
    {"id": "decode-to-shell", "risk": "critical", "oacb": "OACB-OBF-002", "why": "decoded content piped into an interpreter", "cmd": ["base64", "xxd"], "downstream": ["sh", "bash", "zsh", "dash", "ksh", "fish", "python", "python3", "node", "perl", "ruby", "php"]},
    {"id": "remote-process-substitution", "risk": "critical", "oacb": "OACB-OBF-003", "why": "shell runs remote content through process substitution", "cmd": ["sh", "bash", "zsh", "dash", "ksh", "fish", "source", "."], "procsub_cmd": ["curl", "wget", "fetch"]},
    {"id": "netcat", "risk": "high", "oacb": "OACB-NET-002", "why": "netcat family invocation (egress or reverse shell)", "cmd": ["nc", "ncat", "netcat", "socat", "telnet"], "args_re": "\\S"},
    {"id": "dev-tcp-redirect", "risk": "critical", "oacb": "OACB-NET-003", "why": "redirect to /dev/tcp (reverse shell pattern)", "redir_re": "^/dev/(tcp|udp)/"},
    {"id": "dev-tcp-argument", "risk": "critical", "oacb": "OACB-NET-003", "why": "/dev/tcp used as an argument", "argv_re": "/dev/(tcp|udp)/\\S"},
    {"id": "proc-self-root", "risk": "critical", "oacb": "OACB-OBF-004", "why": "/proc/self/root path traversal", "argv_re": "/proc/self/root/"},
    {"id": "history-rewrite", "risk": "critical", "oacb": "OACB-HIST-001", "why": "history -s/-a/-w can write attacker text to a file", "cmd": ["history"], "flags": [["-s", "-a", "-w"]]},
    {"id": "eval-dynamic", "risk": "critical", "oacb": "OACB-EVAL-001", "why": "eval of text that is only known at run time", "cmd": ["eval"], "dyn_args": true},
    {"id": "env-credential-enum", "risk": "high", "oacb": "OACB-EXFIL-001", "why": "searches the environment for credentials", "cmd": ["grep", "egrep", "rg"], "upstream": ["env", "printenv", "set", "export"], "args_re": "(?i)(token|key|secret|password|credential|bearer)"},
    {"id": "k8s-delete-namespace", "risk": "critical", "why": "deletes a whole Kubernetes namespace", "cmd": ["kubectl"], "sub": [["delete", "namespace"], ["delete", "namespaces"], ["delete", "ns"]]},
    {"id": "k8s-delete", "risk": "medium", "why": "deletes Kubernetes resources", "cmd": ["kubectl"], "sub": [["delete"]]},
    {"id": "iac-destroy", "risk": "critical", "oacb": "OACB-TF-001", "why": "destroys managed infrastructure", "cmd": ["terraform", "tofu", "pulumi"], "sub": [["destroy"]]},
    {"id": "iac-apply-destroy", "risk": "critical", "oacb": "OACB-TF-001", "why": "destroys managed infrastructure", "cmd": ["terraform", "tofu"], "sub": [["apply"]], "flags": [["-destroy", "--destroy"]]},
    {"id": "iac-apply-auto-approve", "risk": "high", "oacb": "OACB-TF-002", "why": "applies infrastructure changes without a plan review", "cmd": ["terraform", "tofu"], "sub": [["apply"]], "flags": [["-auto-approve", "--auto-approve"]]},
    {"id": "iac-state-rm", "risk": "high", "oacb": "OACB-TF-003", "why": "removes a resource from state, which can orphan it", "cmd": ["terraform", "tofu"], "sub": [["state", "rm"]]},
    {"id": "chmod-world-writable", "risk": "medium", "why": "recursive world-writable permissions", "cmd": ["chmod"], "flags": [["-R", "--recursive"]], "pos_re": "^(0?777|a\\+rwx|o\\+w)$"},
    {"id": "read-credential-file", "risk": "critical", "why": "reads a private key or credential file", "cmd": ["cat", "less", "more", "head", "tail", "bat", "cp", "scp", "base64", "xxd", "strings"], "pos_re": "(^|/)(id_(rsa|ed25519|ecdsa|dsa)|\\.aws/credentials|\\.netrc|\\.pgpass|\\.kube/config|[^/]*\\.pem)$"},
    {"id": "search-credential-file", "risk": "critical", "why": "searches a private key or credential file", "cmd": ["grep", "egrep", "rg", "awk", "sed"], "pos_re": "(^|/)(id_(rsa|ed25519|ecdsa|dsa)|\\.aws/credentials|\\.netrc|\\.pgpass|\\.kube/config|[^/]*\\.pem)$", "pos_from": 1},
    {"id": "read-dotenv", "risk": "high", "why": "reads an env file that usually holds secrets", "cmd": ["cat", "less", "more", "head", "tail", "bat", "cp", "scp", "base64", "xxd", "strings"], "pos_re": "(^|/)\\.env(\\.(?!example|sample|template)[\\w.]+)?$"},
    {"id": "search-dotenv", "risk": "high", "why": "searches an env file that usually holds secrets", "cmd": ["grep", "egrep", "rg", "awk", "sed"], "pos_re": "(^|/)\\.env(\\.(?!example|sample|template)[\\w.]+)?$", "pos_from": 1},
    {"id": "raw-disk-dd", "risk": "critical", "oacb": "OACB-RM-005", "why": "writes directly to a block device", "cmd": ["dd"], "args_re": "\\bof=/dev/(sd|nvme|hd|vd|disk|mmcblk)"},
    {"id": "raw-disk-redirect", "risk": "critical", "why": "redirects output onto a block device", "redir_re": "^/dev/(sd|nvme|hd|vd|disk|mmcblk)"},
    {"id": "format-disk", "risk": "critical", "oacb": "OACB-RM-006", "why": "formats or wipes a filesystem", "cmd_re": "^(mkfs(\\..+)?|wipefs)$"},
    {"id": "s3-recursive-delete", "risk": "high", "why": "recursive or forced S3 delete", "cmd": ["aws"], "sub": [["s3", "rm"], ["s3", "rb"]], "flags": [["--recursive", "--force"]]},
    {"id": "container-prune", "risk": "medium", "why": "removes containers, images or volumes in bulk", "cmd": ["docker", "podman"], "sub": [["system", "prune"], ["volume", "prune"], ["volume", "rm"]]},
    {"id": "dynamic-command", "risk": "medium", "why": "command name is only known at run time", "dyn_name": true},
    {"id": "glob-command-name", "risk": "high", "why": "command name is a glob pattern, so the binary is chosen at run time", "glob_name": true},
    {"id": "compound-command", "risk": "medium", "oacb": "OACB-COMPOUND-001", "why": "more than 10 command separators in one call", "min_separators": 11}
  ]
}
